# Copy to .env (the setup script does this for you).
# PostgreSQL + the app + the sync watcher run on ONE laptop (localhost).
# Neo4j runs on the teammate's laptop and is reached through an ngrok TCP tunnel:
#   teammate runs:  ngrok tcp 7687   -> shows  tcp://0.tcp.in.ngrok.io:12345
#   you write:      NEO4J_URI="bolt://0.tcp.in.ngrok.io:12345"     (bolt://, NOT neo4j://)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realestate"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password123"
SYNC_POLL_SECONDS=5
